rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 家族(familyId)に属するメンバーか（管理者本人 or メンバーとして登録済み）
    function isFamilyMember(familyId) {
      return isSignedIn() && (
        request.auth.uid == familyId ||
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
      );
    }

    // 管理者（親）本人か
    function isAdmin(familyId) {
      return isSignedIn() && request.auth.uid == familyId;
    }

    // 運営（開発者）本人か。全家族の件数などの統計を見られる特別な閲覧専用ロール
    function isDeveloper() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/developers/$(request.auth.uid));
    }

    // 共通コード（1台の端末を複数の子供で共有）でログインした本人か。家族の全員の分の報告を書き込める
    function isDeviceMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == "device";
    }

    // uid -> familyId/role の索引。ログイン直後にどの家族に属するか解決するために使う
    match /memberIndex/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && (
        request.auth.uid == uid ||
        request.auth.uid == request.resource.data.familyId
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.familyId || isDeveloper());
      allow update: if false;
    }

    // 運営(開発者)フラグ。本人のみ自分がdeveloperかどうかを確認できる（書き込みはコンソール/CLIから行う想定）
    match /developers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 全ユーザー共通の掲示板（家族の垣根を越えて閲覧・投稿できるフィードボード）
    match /feedback/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId;
      allow update: if false;
      allow delete: if isDeveloper();
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId) || isDeveloper();
      allow create: if isSignedIn() && request.auth.uid == familyId;
      allow update: if isAdmin(familyId) || isDeveloper();
      allow delete: if isDeveloper();

      // 子供（owner）・共有者（viewer）。追加/削除/名前変更は管理者のみ（開発者はサポート対応・削除のために書き込み可）
      match /members/{memberId} {
        allow read: if isFamilyMember(familyId) || isDeveloper();
        allow write: if isAdmin(familyId) || isDeveloper();
      }

      // 課題。登録・編集・削除は管理者のみ（開発者は家族削除時のみ書き込み可）
      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isAdmin(familyId) || isDeveloper();
      }

      // 日次報告。管理者、またはその課題の担当（オーナー本人）のみ書き込み可
      match /logs/{logId} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isAdmin(familyId) || isDeviceMember(familyId) || (
          isSignedIn() &&
          request.auth.uid ==
            get(/databases/$(database)/documents/families/$(familyId)/tasks/$(request.resource.data.taskId)).data.childId
        );
        allow delete: if isAdmin(familyId) || isDeveloper();
      }
    }
  }
}
